{
  "name": "espectro-electromagnetico",
  "version": "1.0.0",
  "description": "Plataforma educativa interactiva para explorar el espectro electromagnético",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "dev": "npx nodemon server.js",
    "start": "node server.js",
    "build": "pkg launcher.js --targets node18-win-x64 --output EspectroApp.exe"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "routes/**/*",
      "sockets/**/*",
      "data/**/*",
      "middleware/**/*",
      "utils/**/*"
    ],
    "outputPath": "dist"
  },
  "keywords": ["educativo", "espectro", "electromagnético", "quiz", "socket.io"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "socket.io": "^4.7.2"
  }
}
